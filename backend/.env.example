# PostgreSQL Database Connection URL (or local Docker: postgresql+psycopg2://postgres:postgres@localhost:5432/cliniclog)
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/cliniclog

# Frontend CORS Origin
FRONTEND_ORIGIN=http://localhost:5173

# JWT Authentication Configuration
JWT_SECRET=replace_with_a_secure_random_secret_key_for_production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=30
